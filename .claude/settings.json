{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run test:run*)",
      "Bash(npm run test:integration*)",
      "Bash(npm run build*)",
      "Bash(npx vitest run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(node scripts/generate-dev-cert.mjs*)",
      "Bash(tools/c2patool/c2patool.exe *)",
      "Bash(node_modules/exiftool-vendored.exe/bin/exiftool.exe *)",
      "PowerShell(npm test*)",
      "PowerShell(npm run test:run*)",
      "PowerShell(npm run test:integration*)",
      "PowerShell(npm run build*)",
      "PowerShell(npx vitest run*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git branch*)",
      "PowerShell(git worktree list*)",
      "PowerShell(node scripts/generate-dev-cert.mjs*)"
    ],
    "deny": [
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(certs/**)",
      "Edit(src/server/db/migrations/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push --all*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-repo*)",
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(rm -rf*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push --all*)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git rebase*)",
      "PowerShell(npm run db:push*)",
      "PowerShell(npx drizzle-kit push*)",
      "PowerShell(Remove-Item * -Recurse*)"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\" guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
