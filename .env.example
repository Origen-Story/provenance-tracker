# Database — matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql://provenance:localdev@localhost:5432/provenance

# Server
PORT=3001
NODE_ENV=development

# Log verbosity: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Notion integration (optional — required for Notion sync feature)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx

# File storage root (where downloaded archival images are saved)
# Defaults to ./data/archival/images if not set
# STORAGE_PATH=./data

# Contact info sent in the User-Agent header on outbound HTTP requests.
# Wikimedia's User-Agent policy requires identification (email or URL).
# Unidentified clients are throttled more aggressively or blocked.
# APP_CONTACT=your-email@example.com
