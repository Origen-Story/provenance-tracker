# Provenance Tracker: optional settings. Everything works without a .env.
# Copy this file to .env and uncomment a line only to change its default.
# See README.md, "Environment", for what each one does.

# The server's port.
# PORT=3001

# The address the server listens on. 127.0.0.1 means this machine only.
# Change it only behind a proxy that adds a login (README, Deployment notes).
# HOST=127.0.0.1

# Host names the API answers to beside localhost, comma-separated, for use with HOST.
# ALLOWED_HOSTS=

# Email or web address sent in the User-Agent when the tracker downloads a file
# you asked for. Defaults to the project's web address.
# APP_CONTACT=

# Set to production to serve the built pages from dist/ (npm run build, then npm start).
# NODE_ENV=development

# Server log detail: debug, info, warn or error.
# LOG_LEVEL=info
