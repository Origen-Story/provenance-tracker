engine-strict=true
# Exact versions only (docs/dependencies.md): npm install saves 1.2.3, not ^1.2.3.
save-exact=true
# No package's install script runs (docs/dependencies.md). One package has one:
# the C2PA library's would download its native binary with no checksum. The
# tracker installs that binary itself, pinned and checked (npm run tools:fetch).
ignore-scripts=true
