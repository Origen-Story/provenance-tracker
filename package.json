{
	"name": "provenance-tracker",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"license": "Apache-2.0",
	"homepage": "https://provenancetracker.org",
	"scripts": {
		"dev": "concurrently -n server,client -c \"#5cb88a,#5a9fd4\" \"npm run server:dev\" \"npm run client:dev\"",
		"server:dev": "node --watch --env-file=.env src/server/index.js",
		"client:dev": "vite",
		"build": "vite build",
		"start": "node --env-file=.env src/server/index.js",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"cert:generate": "node scripts/generate-dev-cert.mjs",
		"tools:fetch": "node scripts/fetch-tools.mjs",
		"catalog:write": "node scripts/write-catalog-files.ts",
		"cli": "node packages/core-node/src/cli/main.ts",
		"test": "node scripts/test.mjs",
		"test:run": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run test/integration",
		"audit": "node scripts/audit.mjs",
		"typecheck": "tsc -p . && tsc -p src/client",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@notionhq/client": "5.18.0",
		"@provenancetracker/core": "0.2.0",
		"@tanstack/react-query": "5.95.2",
		"c2pa-node": "0.5.26",
		"drizzle-orm": "0.45.4",
		"express": "5.3.0",
		"multer": "2.5.0",
		"pg": "8.20.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1"
	},
	"overrides": {
		"csstype": "3.2.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tailwindcss/vite": "4.3.4",
		"@types/express": "5.0.6",
		"@types/multer": "2.3.0",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"concurrently": "10.0.6",
		"drizzle-kit": "0.31.11",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"tailwindcss": "4.3.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=24"
	}
}
