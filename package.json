{
	"name": "provenance-tracker",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"scripts": {
		"dev": "concurrently -n server,client -c \"#5cb88a,#5a9fd4\" \"npm run server:dev\" \"npm run client:dev\"",
		"server:dev": "node --watch --env-file=.env src/server/index.js",
		"client:dev": "vite",
		"build": "vite build",
		"start": "node --env-file=.env src/server/index.js",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"cert:generate": "node scripts/generate-dev-cert.mjs",
		"test": "node scripts/test.mjs",
		"test:run": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run test/integration"
	},
	"dependencies": {
		"@notionhq/client": "^5.18.0",
		"@tanstack/react-query": "^5.105.0",
		"c2pa-node": "^0.5.26",
		"drizzle-orm": "^0.45.1",
		"exiftool-vendored": "^35.9.0",
		"express": "^4.21.2",
		"multer": "^2.1.1",
		"pg": "^8.16.0",
		"png-chunk-text": "^1.0.0",
		"png-chunks-extract": "^1.0.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.30.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.0",
		"@vitejs/plugin-react": "^4.5.2",
		"concurrently": "^9.1.2",
		"drizzle-kit": "^0.31.9",
		"tailwindcss": "^4.2.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.4"
	},
	"engines": {
		"node": ">=24"
	}
}
