// Renovate: this repo follows the shared policy in
// https://github.com/indieglo/renovate-config (grouped weekly minor/patch PRs,
// majors wait for Dependency Dashboard approval, 14-day release age,
// SHA-pinned actions). Repo-specific exceptions go below the extends line.
{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: ["github>indieglo/renovate-config"],
	// Pull requests into main must have every commit signed off (sign-off.yml).
	commitBody: "Signed-off-by: {{{gitAuthor}}}",
}
