{
	// Type checking only: Node runs .ts files directly (docs/decisions.md D16),
	// and Vite builds the client. Nothing is emitted.
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		// Imports name the .ts file, as Node needs. rewriteRelativeImportExtensions
		// is left out: it only matters when emitting, and it refuses package
		// imports of .ts files (@provenancetracker/core/...), which Node runs (D28).
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		// Existing JavaScript is read but not checked; a file is checked once it
		// is converted to .ts. The public viewer will opt in with JSDoc + checkJs.
		"allowJs": true,
		"checkJs": false
	},
	"include": [
		"src/server/**/*",
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"scripts/**/*",
		"test/**/*"
	],
	"exclude": ["src/server/db/migrations/**", "packages/*/test/fixtures/**"]
}
